"""Coefficient of Variation (CV).

CV = |std / mean| × 100 for a single-channel time series. Needs to be applied on 
raw light intensity, will not work on optical density, currently not an option for 
  channel exclusion due to our export format.

"""

from __future__ import annotations

import numpy as np


def coefficient_of_variation(signal: np.ndarray) -> float:
    """Return |std / mean| * 100 for a 1-D signal. Lower is better."""
    x = np.asarray(signal, dtype=float).ravel()
    if x.size == 0 or not np.all(np.isfinite(x)):
        return float("nan")
    mean = float(x.mean())
    if mean == 0:
        return float("nan")
    return float(abs(x.std() / mean) * 100)
