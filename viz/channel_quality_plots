"""Per-channel quality PDF: a channel x method pass/fail heatmap, then one page per
channel with pre-TDDR OD and concentration traces, each method's verdict over top
and event markers overlaid. Pre-TDDR data is what the quality metrics actually see."""

from __future__ import annotations

import logging
import math
from pathlib import Path
from typing import Dict, List, Mapping, Optional, Sequence

import matplotlib.patches as mpatches
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from matplotlib.backends.backend_pdf import PdfPages
from matplotlib.colors import ListedColormap

from channel_quality.exclusion import ExclusionCriterion

logger = logging.getLogger(__name__)

WL_COLORS = ("#9467bd", "#ff7f0e")
OXY_COLOR, DEOXY_COLOR = "#d62728", "#1f77b4"
PASS_COLOR, FAIL_COLOR = "#2ca02c", "#d62728"
EVENT_COLOR = "#555555"
GRID_ALPHA = 0.25


def plot_channel_quality_pdf(
    df_od: pd.DataFrame,
    df_conc: pd.DataFrame,
    channel_map: Mapping,
    metrics: Sequence[Mapping],
    criteria: Sequence[ExclusionCriterion],
    fs: float,
    output_path: str | Path,
    title: str | None = None,
    events: Optional[pd.DataFrame] = None,
) -> None:
    """metrics: per-channel rows with 'channel', 'SQI', 'SCI', 'PSP'. Events need
    'Sample number' and 'Event' columns (sample numbers relative to df_od)."""
    output_path = Path(output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    by_ch: Dict[int, Mapping] = {int(m["channel"]): dict(m) for m in metrics}
    if not by_ch:
        logger.warning(f"No metrics to plot for {output_path.name}")
        return

    decisions = {ch: [c.excludes(m) for c in criteria] for ch, m in by_ch.items()}
    t = np.arange(len(df_od)) / fs

    with PdfPages(output_path) as pdf:
        _summary_page(pdf, decisions, criteria, title or output_path.stem)
        for ch in sorted(by_ch):
            info = channel_map.get(ch)
            if info is not None:
                _channel_page(pdf, ch, info, df_od, df_conc, t, by_ch[ch], decisions[ch], criteria, events, fs)


def _summary_page(pdf, decisions: Dict[int, List[bool]], criteria, title: str) -> None:
    channels = sorted(decisions)
    matrix = np.array([[int(e) for e in decisions[ch]] for ch in channels])

    fig, ax = plt.subplots(figsize=(8.5, min(11.0, max(5.0, 0.20 * len(channels) + 1.5))))
    ax.imshow(matrix, aspect="auto", cmap=ListedColormap([PASS_COLOR, FAIL_COLOR]),
              vmin=0, vmax=1, interpolation="nearest")
    ax.set_xticks(range(len(criteria)), [c.name for c in criteria], fontsize=10)
    ax.set_yticks(range(len(channels)), [f"CH {ch}" for ch in channels], fontsize=6)
    ax.tick_params(axis="x", top=True, labeltop=True, bottom=False, labelbottom=False)

    for i, n in enumerate(matrix.sum(axis=0)):
        ax.annotate(f"{n}\n({100.0 * n / len(channels):.0f}%)", xy=(i, len(channels) - 0.5),
                    xytext=(0, -14), textcoords="offset points", ha="center", va="top",
                    fontsize=8, annotation_clip=False)

    ax.set_title(f"Channel exclusion summary — {title}\n" + "  |  ".join(c.description for c in criteria),
                 fontsize=10, pad=18)
    ax.legend(handles=[mpatches.Patch(color=PASS_COLOR, label="pass"),
                       mpatches.Patch(color=FAIL_COLOR, label="fail")],
              loc="lower center", bbox_to_anchor=(0.5, -0.06), ncol=2, frameon=False, fontsize=9)
    fig.tight_layout()
    pdf.savefig(fig, bbox_inches="tight")
    plt.close(fig)


def _channel_page(pdf, ch, info, df_od, df_conc, t, metrics, decisions, criteria, events, fs) -> None:
    fig = plt.figure(figsize=(11, 7.5))
    gs = fig.add_gridspec(3, 1, height_ratios=[1.0, 2.5, 2.5], hspace=0.32)

    _header(fig.add_subplot(gs[0]), ch, metrics, criteria, decisions)
    ax_od = fig.add_subplot(gs[1])
    _od_panel(ax_od, info, df_od, t)
    ax_c = fig.add_subplot(gs[2], sharex=ax_od)
    _conc_panel(ax_c, ch, df_conc, t)
    for ax in (ax_od, ax_c):
        _events(ax, events, fs)

    pdf.savefig(fig, bbox_inches="tight")
    plt.close(fig)


def _header(ax, ch, metrics, criteria, decisions) -> None:
    ax.axis("off")
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)
    ax.text(0.0, 0.85, f"Channel {ch}", fontsize=15, fontweight="bold")
    ax.text(0.0, 0.45,
            f"SQI = {_fmt(metrics.get('SQI'), 2)}    SCI = {_fmt(metrics.get('SCI'), 3)}    "
            f"PSP = {_fmt(metrics.get('PSP'), 2)}",
            fontsize=11, family="monospace")

    # right-aligned verdict badges
    w, gap = 0.105, 0.012
    x0 = 1.0 - (len(criteria) * w + (len(criteria) - 1) * gap)
    for i, (c, excluded) in enumerate(zip(criteria, decisions)):
        x = x0 + i * (w + gap)
        ax.add_patch(mpatches.FancyBboxPatch(
            (x, 0.30), w, 0.62, boxstyle="round,pad=0.005,rounding_size=0.015", linewidth=0.5,
            edgecolor="black", facecolor=FAIL_COLOR if excluded else PASS_COLOR, clip_on=False))
        ax.text(x + w / 2, 0.72, c.name, ha="center", va="center", fontsize=10, fontweight="bold", color="white")
        ax.text(x + w / 2, 0.42, "fail" if excluded else "pass", ha="center", va="center",
                fontsize=9, color="white")


def _panel(ax, t, ylabel: str, drawn: bool, empty_msg: str) -> None:
    ax.set_ylabel(ylabel, fontsize=10)
    ax.set_xlim(t[0], t[-1])
    ax.grid(True, alpha=GRID_ALPHA)
    if drawn:
        ax.legend(loc="upper right", fontsize=8, framealpha=0.9)
    else:
        ax.text(0.5, 0.5, empty_msg, ha="center", va="center", transform=ax.transAxes, fontsize=10, color="gray")


def _od_panel(ax, info, df_od, t) -> None:
    wls = sorted(info.get("columns", {}))
    drawn = False
    for wl, color, label in zip(wls[:2], WL_COLORS, ("WL1", "WL2")):
        cols = info["columns"].get(wl) or []
        if cols and cols[0] in df_od.columns:
            ax.plot(t, df_od[cols[0]].values, color=color, lw=0.6, label=f"{label} ({wl}nm)")
            drawn = True
    _panel(ax, t, "OD", drawn, "no OD data")
    ax.tick_params(axis="x", labelbottom=False)


def _conc_panel(ax, ch, df_conc, t) -> None:
    drawn = False
    for sfx, color, label in (("_oxy", OXY_COLOR, "HbO"), ("_deoxy", DEOXY_COLOR, "HbR")):
        col = f"CH{ch}{sfx}"
        if col in df_conc.columns:
            ax.plot(t, df_conc[col].values, color=color, lw=0.6, label=label)
            drawn = True
    ax.set_xlabel("Time (s)", fontsize=10)
    _panel(ax, t, "ΔConc (µM)", drawn, "no concentration data")
    ax.axhline(0, color="black", lw=0.4, alpha=0.5)


def _events(ax, events: Optional[pd.DataFrame], fs: Optional[float]) -> None:
    if events is None or fs is None or events.empty or "Sample number" not in events.columns:
        return
    top = ax.get_ylim()[1]
    for _, row in events.iterrows():
        try:
            x = int(row["Sample number"]) / float(fs)
        except (TypeError, ValueError):
            continue
        name = str(row.get("Event", "")).strip()
        if not name:
            continue
        ax.axvline(x, color=EVENT_COLOR, ls="--", lw=0.8, alpha=0.6)
        ax.text(x, top, f" {name}", rotation=90, va="top", ha="left", fontsize=6,
                color=EVENT_COLOR, alpha=0.85, clip_on=True)


def _fmt(value, digits: int) -> str:
    try:
        v = float(value)
    except (TypeError, ValueError):
        return "—"
    return "nan" if math.isnan(v) else f"{v:.{digits}f}"
